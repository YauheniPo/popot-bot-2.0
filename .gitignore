# gitignore template for LangChain products, e.g., LangGraph, LangSmith
# website: https://www.langchain.com/
# website: https://www.langchain.com/langgraph

# LangGraph
.langgraph_api/
.env
__pycache__/
.idea/

# Local test, coverage, and Sonar scanner artifacts. These are produced by the
# CI and local analysis runs; they are reproducible and must never be committed.
.coverage
.coverage.*
*-coverage.xml
coverage.xml
htmlcov/
.scannerwork/
sonar-review-context.json

# Local virtual environments and tool caches.
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.py[cod]

# JavaScript coverage consumed by the SonarCloud scan workflow.
hermes-runtime.lcov
