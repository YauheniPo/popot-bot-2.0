# gitignore template for LangChain products, e.g., LangGraph, LangSmith
# website: https://www.langchain.com/
# website: https://www.langchain.com/langgraph

# LangGraph
.langgraph_api/
.env
__pycache__/
.idea/

# Local deployment keys and host keys prepared for Azure Secure Files.
/azure-ci/hermes-vps-known-hosts
/azure-ci/hermes-vps-ssh-key
/azure-ci/hermes-vps-ssh-key.pub

# Local test, coverage, and Sonar scanner artifacts. These are produced by the
# CI and local analysis runs; they are reproducible and must never be committed.
.coverage
.coverage.*
*-coverage.xml
coverage.xml
htmlcov/
.scannerwork/
sonar-review-context.json

# One-off review helpers and local scan outputs. The maintained Sonar
# configuration lives at the repository root, not under hermes/.
/.tmp-*
/hermes/sonar-project.properties
/hermes/sonar-scan.log

# Local virtual environments and tool caches.
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.py[cod]

# JavaScript coverage consumed by the SonarCloud scan workflow.
hermes-runtime.lcov
.runtime/swarm-missions.json

# Local backup copies. A stale `.bak` next to a maintained script shadows
# nothing but invites edits to a file that never runs; they must not be
# committed by accident either.
*.bak
*.bak[0-9]
*.orig
