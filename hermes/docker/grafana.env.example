# Required for the local Grafana dashboard at http://127.0.0.1:3000.
# Copy this file to hermes/docker/grafana.env and replace the password before
# the first start. This file is intentionally separate from local.env, so the
# Grafana container never receives Hermes, Telegram, GitHub, or LLM secrets.
GF_SECURITY_ADMIN_USER=hermes
GF_SECURITY_ADMIN_PASSWORD="replace-with-a-long-unique-local-password"
