# Template only. Copy to `hermes/docker/local.env` and add only credentials
# needed for local testing. `local.env` is ignored by Git and is injected into
# the container, never mounted.
OPENROUTER_API_KEY="replace-with-local-test-key"

# OpenRouter is the default local LLM provider. `openrouter/free` automatically
# selects a free model compatible with the requested capabilities. Choose a
# different model only when you intentionally enable paid OpenRouter usage.
HERMES_LOCAL_OPENROUTER_MODEL=openrouter/free
HERMES_LOCAL_OPENROUTER_MAX_TOKENS=2048

# Free built-in text-to-speech. The bootstrap chooses a Russian Edge voice and
# retries transient `NoAudioReceived` responses twice. Override only if you
# prefer another voice from `edge-tts --list-voices`.
HERMES_LOCAL_EDGE_TTS_VOICE=ru-RU-SvetlanaNeural

# Optional, but required if Brave is to provide `web_search`. Hermes calls the
# backend `brave-free`; this is a name only and Brave still requires its API key.
# Without this key Hermes auto-selects Nous Tool Gateway after `hermes auth`, or
# another configured web backend. Do not put the key in config.yaml.
# BRAVE_SEARCH_API_KEY="replace-with-brave-search-api-key"

# Required for the Docker dashboard at http://127.0.0.1:9119. Replace both
# values before starting; the port is intentionally bound to localhost only.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=hermes
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD="длинный-уникальный-local-пароль"

# Telegram gateway. With both values the container starts a bot that accepts
# only your account. With neither it starts Dashboard-only mode. Never use
# GATEWAY_ALLOW_ALL_USERS=true for this container.
# TELEGRAM_BOT_TOKEN="replace-with-local-test-token"
# TELEGRAM_ALLOWED_USERS="123456789"

# GitHub. A fine-grained token is injected only at runtime and is never baked
# into the image or persisted by gh. Grant it only the repositories and
# permissions needed for the test (typically Contents and Pull requests).
# GITHUB_TOKEN="github_pat_replace-with-local-test-token"
HERMES_LOCAL_GITHUB_HOST=github.com
HERMES_LOCAL_GIT_NAME="Your Name"
HERMES_LOCAL_GIT_EMAIL="you@example.com"
