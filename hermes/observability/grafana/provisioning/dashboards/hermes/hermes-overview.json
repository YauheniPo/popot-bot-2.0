      "targets": [{"expr": "hermes_host_load", "legendFormat": "load {{window}}", "refId": "A"}, {"expr": "hermes_host_inode_used_ratio", "legendFormat": "inode used", "refId": "B"}],
      "title": "Host load and inode pressure",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max", "mean"]}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "rate(hermes_gateway_process_cpu_seconds_total[$__rate_interval])", "legendFormat": "Hermes gateway CPU cores", "refId": "A"}, {"expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval]))", "legendFormat": "Host CPU used", "refId": "B"}],
      "title": "Gateway and host CPU",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max", "mean"]}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "hermes_gateway_process_resident_memory_bytes", "legendFormat": "Hermes gateway RSS", "refId": "A"}, {"expr": "node_memory_MemAvailable_bytes", "legendFormat": "Host available memory", "refId": "B"}],
      "title": "Gateway and host memory",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "description": "Recorded user input messages in the preceding hour, per profile. Sliding window gauge, not LLM calls or a lifetime counter. Prometheus history begins at the first scrape.",
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max", "mean"]}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "hermes_profile_user_requests{window=\"1h\"}", "legendFormat": "{{profile}} · requests", "refId": "A"}],
      "title": "Profile requests — preceding hour",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "description": "Counts from retained Hermes input history. Includes recorded smoke-test prompts. Deleting, importing or restoring history changes these gauges; do not apply rate/increase.",
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max", "mean"]}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "hermes_profile_user_requests{window=~\"24h|7d|retained\"}", "legendFormat": "{{profile}} · {{window}}", "refId": "A"}],
      "title": "Profile requests — day / week / retained history",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "description": "Time of the most recent retained user input, not process startup or background maintenance. Empty history is shown as No requests.",
      "fieldConfig": {"defaults": {"unit": "dateTimeAsLocal", "mappings": [{"type": "value", "options": {"0": {"text": "No requests"}}}]}, "overrides": []},
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 48},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "hermes_profile_last_request_timestamp_seconds * 1000", "legendFormat": "{{profile}}", "instant": true, "refId": "A"}],
      "title": "Profile last request",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "description": "Approximate time from each retained user message to the following assistant response, aggregated by profile and lookback window.",
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 54},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max", "mean"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "hermes_profile_response_duration_seconds{window=~\"1h|24h|7d\"}", "legendFormat": "{{profile}} · {{window}} · response time", "refId": "A"}],
      "title": "Profile activity duration — selected time range",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "description": "Each profile's latest completed call duration from its user-message start to assistant-response end. The table shows the last, maximum and mean values in the selected Grafana range.",
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 62},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max", "mean"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "hermes_profile_last_request_duration_seconds", "legendFormat": "{{profile}} · latest call duration", "refId": "A"}],
      "title": "Agent call duration — start to end",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "description": "Latest observed activity for each profile, including the assistant response timestamp when available.",
      "fieldConfig": {"defaults": {"unit": "dateTimeAsLocal", "mappings": [{"type": "value", "options": {"0": {"text": "No activity"}}}]}, "overrides": []},
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 54},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "hermes_profile_last_activity_timestamp_seconds * 1000", "legendFormat": "{{profile}} · last activity", "instant": true, "refId": "A"}],
      "title": "Profile last activity",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "description": "Zero means missing/unreadable history or a query timeout; usage is then unknown, not zero. One means the profile history was read successfully, including an empty history.",
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "mappings": [{"type": "value", "options": {"0": {"text": "History unavailable", "color": "red"}, "1": {"text": "History readable", "color": "green"}}}]}, "overrides": []},
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 48},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "hermes_profile_history_readable", "legendFormat": "{{profile}}", "instant": true, "refId": "A"}],
      "title": "Profile usage collection",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "description": "Provider/model pairs that returned rate-limit responses. Use this panel to identify unstable routes over the selected Grafana range.",
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 70},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "sum", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (provider, model) (increase(hermes_api_rate_limits_total[$__range]))", "legendFormat": "{{provider}} / {{model}}", "refId": "A"}],
      "title": "Provider rate limits — selected range",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "description": "Latest rate-limit event timestamp per provider/model. Zero means no observed rate limit.",
      "fieldConfig": {"defaults": {"unit": "dateTimeAsLocal", "mappings": [{"type": "value", "options": {"0": {"text": "No rate limits"}}}]}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 70},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "hermes_api_last_rate_limit_timestamp_seconds * 1000", "legendFormat": "{{provider}} / {{model}}", "instant": true, "refId": "A"}],
      "title": "Last provider rate limit",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "description": "Input and output token throughput by provider and model. Total token metrics remain available in the panel above.",
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 12, "lineWidth": 2}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 79},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max", "mean"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "sum by (provider, model) (rate(hermes_input_tokens_total[$__rate_interval]))", "legendFormat": "{{provider}} / {{model}} input", "refId": "A"},
        {"expr": "sum by (provider, model) (rate(hermes_output_tokens_total[$__rate_interval]))", "legendFormat": "{{provider}} / {{model}} output", "refId": "B"}
      ],
      "title": "Token throughput by provider and model",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "description": "Successful responses divided by all responses in the selected range. Provider and model stay visible in the legend.",
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 88},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "min", "mean"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (provider, model) (rate(hermes_api_success_total[$__rate_interval])) / clamp_min(sum by (provider, model) (rate(hermes_api_success_total[$__rate_interval]) + rate(hermes_api_errors_total[$__rate_interval])), 1e-9)", "legendFormat": "{{provider}} / {{model}} availability", "refId": "A"}],
      "title": "Model availability",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "description": "Average time spent waiting for a provider response, including stream completion as reported by the Hermes API hook.",
      "fieldConfig": {"defaults": {"unit": "ms", "min": 0}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 88},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max", "mean"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (provider, model) (rate(hermes_api_duration_ms_total[$__rate_interval])) / clamp_min(sum by (provider, model) (rate(hermes_api_calls_total[$__rate_interval])), 1e-9)", "legendFormat": "{{provider}} / {{model}} latency", "refId": "A"}],
      "title": "Model response latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "description": "Retry activity by provider and model. Spikes indicate recovery work and unstable availability.",
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 97},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "sum", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (provider, model) (rate(hermes_api_retries_total[$__rate_interval]))", "legendFormat": "{{provider}} / {{model}} retries", "refId": "A"}],
      "title": "API recovery attempts",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "description": "Latest successful, failed and rate-limited response timestamps by provider/model; useful for finding long periods of unavailability. Empty cell means the event was never observed.",
      "fieldConfig": {"defaults": {"unit": "dateTimeAsLocal", "mappings": [{"type": "value", "options": {"0": {"text": "No event"}}}]}, "overrides": []},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 106},
      "options": {"cellHeight": "lg", "showHeader": true, "sortBy": [{"displayName": "Last success", "desc": true}]},
      "targets": [
        {"expr": "hermes_api_last_success_timestamp_seconds * 1000", "format": "table", "instant": true, "refId": "A"},
        {"expr": "hermes_api_last_error_timestamp_seconds * 1000", "format": "table", "instant": true, "refId": "B"},
        {"expr": "hermes_api_last_rate_limit_timestamp_seconds * 1000", "format": "table", "instant": true, "refId": "C"}
      ],
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Time": true}}},
        {"id": "merge", "options": {}},
        {"id": "organize", "options": {"renameByName": {"Value #A": "Last success", "Value #B": "Last error", "Value #C": "Last rate limit"}}}
      ],
      "title": "Model/provider — latest availability events",
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "description": "Route scorecard for the selected range. Availability and first-attempt success show stability, p95 and output tok/s show speed, truncation and empty-response shares are quality proxies. Routes without traffic in the range have no ratio values instead of a misleading 0; errors include every class.",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": [{"matcher": {"id": "byName", "options": "Availability"}, "properties": [{"id": "unit", "value": "percentunit"}]}, {"matcher": {"id": "byName", "options": "First-attempt success"}, "properties": [{"id": "unit", "value": "percentunit"}]}, {"matcher": {"id": "byName", "options": "p95 response time"}, "properties": [{"id": "unit", "value": "ms"}]}, {"matcher": {"id": "byName", "options": "Truncated"}, "properties": [{"id": "unit", "value": "percentunit"}]}, {"matcher": {"id": "byName", "options": "Empty responses"}, "properties": [{"id": "unit", "value": "percentunit"}]}, {"matcher": {"id": "byName", "options": "Cost per success"}, "properties": [{"id": "unit", "value": "currencyUSD"}]}]},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 116},
      "options": {"cellHeight": "lg", "showHeader": true, "sortBy": [{"displayName": "Availability", "desc": true}]},
      "targets": [
        {"expr": "sum by (provider, model) (increase(hermes_api_success_total[$__range])) / (sum by (provider, model) (increase(hermes_api_calls_total[$__range])) > 0)", "format": "table", "instant": true, "refId": "A"},
        {"expr": "sum by (provider, model) (increase(hermes_api_first_attempt_success_total[$__range])) / (sum by (provider, model) (increase(hermes_api_success_total[$__range])) > 0)", "format": "table", "instant": true, "refId": "B"},
        {"expr": "histogram_quantile(0.95, sum by (provider, model, le) (increase(hermes_api_duration_ms_bucket{status=\"ok\"}[$__range])))", "format": "table", "instant": true, "refId": "C"},
        {"expr": "1000 * sum by (provider, model) (increase(hermes_output_tokens_total{status=\"ok\"}[$__range])) / (sum by (provider, model) (increase(hermes_api_duration_ms_total{status=\"ok\"}[$__range])) > 0)", "format": "table", "instant": true, "refId": "D"},
        {"expr": "sum by (provider, model) (increase(hermes_api_finish_total{reason=\"length\"}[$__range])) / (sum by (provider, model) (increase(hermes_api_success_total[$__range])) > 0)", "format": "table", "instant": true, "refId": "E"},
        {"expr": "sum by (provider, model) (increase(hermes_api_empty_success_total[$__range])) / (sum by (provider, model) (increase(hermes_api_success_total[$__range])) > 0)", "format": "table", "instant": true, "refId": "F"},
        {"expr": "sum by (provider, model) (increase(hermes_cost_usd_total{status=\"ok\"}[$__range])) / (sum by (provider, model) (increase(hermes_api_success_total[$__range])) > 0)", "format": "table", "instant": true, "refId": "G"},
        {"expr": "sum by (provider, model) (increase(hermes_api_success_total[$__range]))", "format": "table", "instant": true, "refId": "H"},
