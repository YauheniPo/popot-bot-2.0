      "gridPos": {"h": 7, "w": 4, "x": 12, "y": 0},
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "sum(increase(hermes_tokens_total[$__range]))", "refId": "A"}],
      "title": "Tokens in selected range",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 12, "lineWidth": 2}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 7},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (provider, model) (rate(hermes_tokens_total[$__rate_interval]))", "legendFormat": "{{provider}} / {{model}}", "refId": "A"}],
      "title": "Token rate by model",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 12, "lineWidth": 2}, "unit": "currencyUSD"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 7},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (provider, model) (rate(hermes_cost_usd_total[$__rate_interval]))", "legendFormat": "{{provider}} / {{model}}", "refId": "A"}],
      "title": "LLM cost rate by model",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 12, "lineWidth": 2}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 16},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (tool, status) (rate(hermes_tool_calls_total[$__rate_interval]))", "legendFormat": "{{tool}} / {{status}}", "refId": "A"}],
      "title": "Tool calls by status",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 12, "lineWidth": 2}, "unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 16},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "hermes_host_memory_available_ratio", "legendFormat": "memory available", "refId": "A"}, {"expr": "1 - hermes_host_disk_used_ratio", "legendFormat": "disk available", "refId": "B"}],
      "title": "Available resources",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.02}, {"color": "red", "value": 0.05}]}}, "overrides": []},
      "gridPos": {"h": 7, "w": 6, "x": 0, "y": 25},
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "sum(rate(hermes_api_calls_total{status=\"error\"}[$__rate_interval])) / clamp_min(sum(rate(hermes_api_calls_total[$__rate_interval])), 1)", "refId": "A"}],
      "title": "API error rate",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "gridPos": {"h": 7, "w": 6, "x": 6, "y": 25},
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "sum(rate(hermes_api_duration_ms_total[$__rate_interval])) / clamp_min(sum(rate(hermes_api_calls_total[$__rate_interval])), 1)", "refId": "A"}],
      "title": "Average API latency",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "fieldConfig": {"defaults": {"unit": "h", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 26}, {"color": "red", "value": 48}]}}, "overrides": []},
      "gridPos": {"h": 7, "w": 6, "x": 12, "y": 25},
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "hermes_backup_age_seconds / 3600", "refId": "A"}],
      "title": "Latest backup age",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 12, "lineWidth": 2}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 7, "w": 6, "x": 18, "y": 25},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "hermes_host_load", "legendFormat": "load {{window}}", "refId": "A"}, {"expr": "hermes_host_inode_used_ratio", "legendFormat": "inode used", "refId": "B"}],
      "title": "Host load and inode pressure",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "rate(hermes_gateway_process_cpu_seconds_total[$__rate_interval])", "legendFormat": "Hermes gateway CPU cores", "refId": "A"}, {"expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval]))", "legendFormat": "Host CPU used", "refId": "B"}],
      "title": "Gateway and host CPU",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "hermes_gateway_process_resident_memory_bytes", "legendFormat": "Hermes gateway RSS", "refId": "A"}, {"expr": "node_memory_MemAvailable_bytes", "legendFormat": "Host available memory", "refId": "B"}],
      "title": "Gateway and host memory",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "description": "Recorded user input messages in the preceding hour, per profile. Sliding window gauge, not LLM calls or a lifetime counter. Prometheus history begins at the first scrape.",
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "hermes_profile_user_requests{window=\"1h\"}", "legendFormat": "{{profile}}", "refId": "A"}],
      "title": "Profile requests — preceding hour",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "description": "Counts from retained Hermes input history. Includes recorded smoke-test prompts. Deleting, importing or restoring history changes these gauges; do not apply rate/increase.",
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "hermes_profile_user_requests{window=~\"24h|7d|retained\"}", "legendFormat": "{{profile}} · {{window}}", "instant": true, "refId": "A"}],
      "title": "Profile requests — day / week / retained history",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "description": "Time of the most recent retained user input, not process startup or background maintenance. Empty history is shown as No requests.",
      "fieldConfig": {"defaults": {"unit": "dateTimeAsLocal", "mappings": [{"type": "value", "options": {"0": {"text": "No requests"}}}]}, "overrides": []},
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 48},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "hermes_profile_last_request_timestamp_seconds * 1000", "legendFormat": "{{profile}}", "instant": true, "refId": "A"}],
      "title": "Profile last request",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hermes-prometheus"},
      "description": "Zero means missing/unreadable history or a query timeout; usage is then unknown, not zero. One means the profile history was read successfully, including an empty history.",
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "mappings": [{"type": "value", "options": {"0": {"text": "History unavailable", "color": "red"}, "1": {"text": "History readable", "color": "green"}}}]}, "overrides": []},
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 48},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "hermes_profile_history_readable", "legendFormat": "{{profile}}", "instant": true, "refId": "A"}],
      "title": "Profile usage collection",
      "type": "stat"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["hermes", "observability"],
  "templating": {"list": []},
  "time": {"from": "now-24h", "to": "now"},
