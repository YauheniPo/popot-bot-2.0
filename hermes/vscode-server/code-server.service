[Unit]
Description=code-server - VS Code Web IDE for Hermes VPS
After=network.target

[Service]
Type=simple
User=hermes
ExecStart=/usr/bin/code-server --bind-addr 0.0.0.0:3000 --auth password --cert false --disable-telemetry
Restart=on-failure
RestartSec=5
WorkingDirectory=/home/hermes

# Security hardening
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
AmbientCapabilities=
SystemCallFilter=@system-service @mount @file-ops

[Install]
WantedBy=multi-user.target