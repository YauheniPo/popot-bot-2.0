---
# Template only. Copy this file to `ansible/group_vars/all/vault.yml`, encrypt
# that working file immediately, and then use `ansible-vault edit
# group_vars/all/vault.yml`. Never put real values in this example.

# Whether Ansible owns .env is non-secret and is configured at
# vps_deploy.secret_environment.managed in config/vps-defaults.yml. Put every
# environment-based Hermes secret you use in this encrypted mapping when that
# setting is true; manual remote .env edits are then replaced on the next run.
hermes_secret_env: {}

# SSH connection details are encrypted here so the VPS address is not present
# in the repository. These variables are consumed by the neutral inventory
# alias in inventory.ini.
# ansible_host: "203.0.113.10"
# ansible_user: "root"

# Replace the empty mapping above with all provider and integration credentials
# you use. Managed .env deployment rejects an empty mapping.
# hermes_secret_env:
#   # Optional alternative provider; the managed default remains Ollama Cloud.
#   OPENROUTER_API_KEY: "replace-inside-ansible-vault"
#   # NVIDIA NIM / build.nvidia.com. Optional alternative to Ollama Cloud.
#   NVIDIA_API_KEY: "replace-inside-ansible-vault"
#   # Ollama Cloud / ollama.com/settings/keys. Enables the ollama-cloud provider
#   # in /model; no local Ollama server or custom endpoint configuration needed.
#   OLLAMA_API_KEY: "replace-inside-ansible-vault"
#   # Separate web providers used by the managed config defaults.
#   BRAVE_SEARCH_API_KEY: "replace-inside-ansible-vault"
#   FIRECRAWL_API_KEY: "replace-inside-ansible-vault"
#
#   # Non-LLM integrations are managed by the same map:
#   # Brave's Hermes backend is named `brave-free`, but Brave still requires
#   # this key for `web_search`. Without it Hermes may use Nous Tool Gateway
#   # after OAuth or another configured backend instead.
#   # Providing both values starts the Telegram gateway automatically.
#   TELEGRAM_BOT_TOKEN: "replace-inside-ansible-vault"
#   TELEGRAM_ALLOWED_USERS: "123456789"
#   # Preferred name for the bundled Hermes GitHub skills and gh. Use a
#   # fine-grained PAT limited to the repositories and permissions you need.
#   GITHUB_TOKEN: "replace-inside-ansible-vault"
#   # Optional Azure DevOps PAT for terminal REST requests (also recognized by
#   # Azure DevOps CLI if installed separately). Scope it to the required work.
#   AZURE_DEVOPS_EXT_PAT: "replace-inside-ansible-vault"
#   # Optional SonarQube user/PAT token for reading issues and Quality Gates.
#   # A GitHub Actions SONAR_TOKEN is not automatically available on the VPS.
#   SONAR_TOKEN: "replace-inside-ansible-vault"

# Non-secret config.yaml policy belongs in
# config/vps-defaults.yml:vps_hermes.config.managed_overlay, not in Vault.
# Service URLs, organizations and project IDs belong in vps_integrations in
# the same config/vps-defaults.yml, not in this secret mapping.

# Required when vps_deploy.features.observability=true. Ansible writes this to the root-only
# /etc/hermes-grafana.env before Grafana can start. Never use the local Docker
# grafana.env file on a VPS.
hermes_grafana_admin_password: "replace-inside-ansible-vault"

# Required when vps_deploy.features.vscode_server=true (enabled by default in
# vps-defaults.yml). Ansible writes this to the root-only /etc/code-server.env.
# This protects the browser IDE behind the SSH tunnel; it is not a substitute
# for keeping vps_vscode.host_port loopback-only.
# Any non-empty password is accepted; the deployment JSON-escapes it for the
# Docker Compose environment file.
hermes_code_server_password: "replace-inside-ansible-vault"

# Optional one-use, ephemeral, tagged Tailscale auth key. Leave empty to run
# `sudo tailscale up --ssh` interactively.
tailscale_auth_key: ""
