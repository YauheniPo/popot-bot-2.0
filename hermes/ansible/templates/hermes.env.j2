# Managed by Ansible Vault via hermes_secret_env.
# Manual changes are replaced on the next playbook run.
{% for item in hermes_secret_env | dict2items | sort(attribute='key') %}
{{ item.key }}={{ item.value | string | to_json }}
{% endfor %}
{% set github_token = hermes_secret_env.get('GITHUB_TOKEN', hermes_secret_env.get('GH_TOKEN', hermes_secret_env.get('GITHUB_PERSONAL_ACCESS_TOKEN', ''))) %}
{% if github_token and 'GITHUB_TOKEN' not in hermes_secret_env %}
# Compatibility alias consumed by gh and the bundled Hermes GitHub skills.
GITHUB_TOKEN={{ github_token | string | to_json }}
{% endif %}
# Required by Chrome for Testing on Ubuntu VPS images with AppArmor user-namespace restrictions.
# This non-secret value is managed in config/vps-defaults.yml.
AGENT_BROWSER_ARGS={{ vps_browser.launch_args | string | to_json }}
# Non-secret persistent launch configuration written by install-browser-automation.sh.
AGENT_BROWSER_CONFIG="{{ hermes_home }}/agent-browser-config.json"
