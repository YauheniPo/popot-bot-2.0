# Managed by Ansible Vault via hermes_secret_env.
# Manual changes are replaced on the next playbook run.
{% for item in hermes_secret_env | dict2items | sort(attribute='key') %}
{% if item.key == 'API_SERVER_KEY' and (vps_deploy.features.workspace_ui | default(false) | bool) %}
# Wire token derived from the Vault input for Hermes's upstream >=16-character
# guard and ASCII HTTP headers. Hashing does NOT add entropy to a short input.
{{ item.key }}={{ item.value | hash('sha256') | to_json }}
{% elif item.key == 'HERMES_WORKSPACE_PASSWORD' %}
{{ item.key }}={{ item.value | string | to_json(ensure_ascii=false) }}
{% else %}
{{ item.key }}={{ item.value | string | to_json }}
{% endif %}
{% endfor %}
{% set github_token = hermes_secret_env.get('GITHUB_TOKEN', hermes_secret_env.get('GH_TOKEN', hermes_secret_env.get('GITHUB_PERSONAL_ACCESS_TOKEN', ''))) %}
{% if github_token and 'GITHUB_TOKEN' not in hermes_secret_env %}
# Compatibility alias consumed by gh and the bundled Hermes GitHub skills.
GITHUB_TOKEN={{ github_token | string | to_json }}
{% endif %}
# Required by Chrome for Testing on Ubuntu VPS images with AppArmor user-namespace restrictions.
# This non-secret value is managed in config/vps-defaults.yml.
AGENT_BROWSER_ARGS={{ vps_browser.launch_args | string | to_json }}
{% if (hermes_searxng_url | default('', true) | string | length) > 0 %}
# Non-secret SearXNG endpoint managed in config/vps-defaults.yml.
SEARXNG_URL={{ hermes_searxng_url | string | to_json }}
{% endif %}
# Non-secret persistent launch configuration written by install-browser-automation.sh.
AGENT_BROWSER_CONFIG="{{ hermes_home }}/agent-browser-config.json"
AI_DIGEST_STATE_DIR={{ (hermes_home ~ '/ops/news') | to_json }}
AI_DIGEST_OUTPUT_DIR={{ (hermes_workspace ~ '/digests') | to_json }}
AI_DIGEST_SKILL_DIR={{ (hermes_bundle_dir ~ '/skills/ai_digest') | to_json }}
# The collector prefers AI_DIGEST_SEARCH_URL and falls back to SEARXNG_URL for compatibility.
{% if (hermes_searxng_url | default('', true) | string | length) > 0 %}
AI_DIGEST_SEARCH_URL={{ hermes_searxng_url | string | to_json }}
{% endif %}
{% if vps_deploy.features.workspace_ui | default(false) | bool %}
# Workspace attaches to this gateway; never starts a second Telegram process.
API_SERVER_ENABLED="true"
API_SERVER_HOST="127.0.0.1"
API_SERVER_PORT="{{ vps_workspace_ui.api_port }}"
{% endif %}
