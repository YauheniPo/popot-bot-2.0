# Managed by Ansible from encrypted vault.yml. Do not edit on the VPS.
# The codercom image reads the password from the PASSWORD environment variable.
PASSWORD={{ hermes_code_server_password | to_json }}
VPS_USER_HOME={{ hermes_user_home }}
VPS_HERMES_HOME={{ hermes_home }}
HERMES_UID={{ hermes_vscode_uid.stdout }}
HERMES_GID={{ hermes_vscode_gid.stdout }}
CODE_SERVER_REPOSITORIES_DIR={{ hermes_github_repositories_dir }}
CODE_SERVER_PROJECT_NAME={{ vps_vscode.project_name }}
CODE_SERVER_IMAGE={{ vps_vscode.image }}
CODE_SERVER_BIND_ADDRESS={{ vps_vscode.bind_address }}
CODE_SERVER_HOST_PORT={{ vps_vscode.host_port }}
CODE_SERVER_TIMEZONE={{ vps_vscode.timezone }}
