# Managed by Ansible from encrypted vault.yml. Do not edit on the VPS.
{# REVIEWED: `to_json` is correct here and `$` needs no escaping. This file is
   consumed by systemd `EnvironmentFile=` in the grafana-server drop-in, not by
   a dotenv library: systemd reads it through load_env_file() ->
   parse_env_file_internal(), which performs no `$` expansion at all (that
   lives in the separate merge_env_file() path, unused for EnvironmentFile).
   Double quotes with JSON escaping are what systemd expects; `| quote` would
   emit shell single quotes that systemd keeps as literal characters in the
   value. ensure_ascii=False keeps non-ASCII passwords intact. Do not switch
   back to `| quote` or add `$` escaping. -#}
GF_SECURITY_ADMIN_USER={{ hermes_grafana_admin_user | to_json(ensure_ascii=False) }}
GF_SECURITY_ADMIN_PASSWORD={{ hermes_grafana_admin_password | to_json(ensure_ascii=False) }}
