[Unit]
Description=Hermes web dashboard (loopback only)
After=network-online.target @GATEWAY_SERVICE@
Wants=network-online.target

[Service]
Type=simple
User=@HERMES_USER@
Group=@HERMES_GROUP@
WorkingDirectory=@HERMES_HOME@
Environment=HOME=@USER_HOME@
Environment=HERMES_HOME=@HERMES_HOME@
Environment=PATH=@USER_HOME@/.local/bin:@HERMES_HOME@/node/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@HERMES_BIN@ dashboard --host @DASHBOARD_BIND_ADDRESS@ --port @DASHBOARD_PORT@ --no-open
Restart=on-failure
RestartSec=@SERVICE_RESTART_SEC@
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@HERMES_HOME@
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
