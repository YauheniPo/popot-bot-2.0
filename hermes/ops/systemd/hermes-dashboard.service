[Unit]
Description=Hermes web dashboard (loopback only)
After=network-online.target hermes-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=@HERMES_USER@
Group=@HERMES_GROUP@
WorkingDirectory=@HERMES_HOME@
Environment=HOME=@USER_HOME@
Environment=HERMES_HOME=@HERMES_HOME@
Environment=PATH=@USER_HOME@/.local/bin:@HERMES_HOME@/node/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@HERMES_BIN@ dashboard --host 127.0.0.1 --port 9119 --no-open
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@HERMES_HOME@
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
