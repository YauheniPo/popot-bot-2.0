[Unit]
Description=Hermes gateway startup notification
After=network-online.target hermes-gateway.service
Wants=network-online.target
Requisite=hermes-gateway.service
PartOf=hermes-gateway.service

[Service]
Type=oneshot
User=@HERMES_USER@
Group=@HERMES_GROUP@
Environment=HOME=@USER_HOME@
Environment=HERMES_HOME=@HERMES_HOME@
Environment=HERMES_BIN=@HERMES_BIN@
Environment=PATH=@USER_HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/etc/hermes-ops.conf
ExecStart=/usr/local/lib/hermes-ops/startup-notify.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=@HERMES_HOME@
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=hermes-gateway.service
